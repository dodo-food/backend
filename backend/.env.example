# ═══════════════════════════════════════════════════════════════════════════════
#  FoodBF / Dodo — Variables d'environnement Backend
#  Dev local : copier en .env et remplir les valeurs
#  Production : configurer dans Railway Dashboard → Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ── Serveur ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# BACKEND_PORT pour le dev local uniquement (Railway injecte PORT automatiquement)
BACKEND_PORT=3001

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Générer depuis : Firebase Console → Paramètres projet → Comptes de service → Générer une nouvelle clé privée
# Coller le contenu JSON complet sur une seule ligne
FIREBASE_PROJECT_ID=kassiripulse
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"kassiripulse",...}

# ── Base de données PostgreSQL ─────────────────────────────────────────────────
# Railway → DATABASE_URL est injecté automatiquement via le plugin PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/foodbf
# Dev local / autre hébergeur :
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=foodbf
# DB_USER=postgres
# DB_PASSWORD=postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optionnel — Upstash free tier recommandé (https://upstash.com)
# Sans REDIS_URL : cache mémoire + BullMQ désactivé (app fonctionne quand même)
REDIS_URL=redis://:password@host.upstash.io:6379

# ── Paiement YengaPay ─────────────────────────────────────────────────────────
YENGAPAY_API_KEY=your_yengapay_api_key
YENGAPAY_MERCHANT_ID=your_merchant_id
YENGAPAY_BASE_URL=https://api.yengapay.com/v1
YENGAPAY_WEBHOOK_SECRET=your_webhook_secret_hmac

# ── Email OTP (Brevo) ─────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-...
BREVO_SENDER=noreply@foodbf.com

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=foodbf_signed

# ── Sécurité ──────────────────────────────────────────────────────────────────
# URLs autorisées séparées par virgule (app mobile Expo, dashboard vendeur, etc.)
CORS_ORIGIN=https://<ton-projet>.up.railway.app,https://your-expo-app.com

# ── Google Maps (optionnel) ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_key
